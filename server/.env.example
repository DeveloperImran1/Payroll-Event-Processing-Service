# ==============================================================================
# Backend Server Environment Variables
# ==============================================================================
# Copy this file to `server/.env` for local standalone development:
#   cp server/.env.example server/.env

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# HTTP Server Port
PORT=5000

# PostgreSQL Connection String (Used by Prisma ORM)
# Default for Docker Compose is port 5433 (host) / 5432 (container). For local standalone Postgres, use port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payroll_db?schema=public"

# Redis Server Configuration (Used by BullMQ for Queue and Job Processing)
REDIS_HOST=localhost
REDIS_PORT=6379
