# ==============================================================================
# Payroll Event Processing Service - Root Environment Variables Guide
# ==============================================================================
#
# 1. For Backend Server:
#    Copy `server/.env.example` to `server/.env`
#    NODE_ENV=development
#    PORT=5000
#    DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payroll_db?schema=public"
#    REDIS_HOST=localhost
#    REDIS_PORT=6379
#
# 2. For Frontend Next.js Client:
#    Copy `client/.env.example` to `client/.env.local`
#    NEXT_PUBLIC_BASE_API_URL=http://localhost:5000/api/v1
#
# Note: If running via Docker Compose (`docker-compose up --build`), the container
# networking environment variables are already automatically configured inside `docker-compose.yml`.
